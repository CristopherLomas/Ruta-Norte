# ==============================================================================
# RUTA NORTE — VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env.local y completa con los valores correspondientes.
# NUNCA incluyas contraseñas reales ni claves de servicio en este archivo ni en el repositorio.
# ==============================================================================

# Supabase — Conexión pública (cliente y servidor)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Supabase — Clave de servicio para operaciones administrativas (SOLO SERVIDOR, NUNCA EXPONER AL CLIENTE)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL base de la aplicación (para redirecciones de Auth y enlaces)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Identity Services (OAuth 2.0 / One Tap; requiere configurar la verificación del token en el backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Entorno de ejecución
NODE_ENV=development

# Credenciales de usuarios de demostración (SOLO PARA DESARROLLO LOCAL)
# Las contraseñas de las cuentas demo NUNCA se almacenan en el repositorio.
DEMO_ADMIN_PASSWORD=contrasena-segura-admin-demo
DEMO_OPERATOR_PASSWORD=contrasena-segura-operador-demo
DEMO_SELLER_PASSWORD=contrasena-segura-vendedor-demo
DEMO_INSPECTOR_PASSWORD=contrasena-segura-inspector-demo
DEMO_PASSENGER_PASSWORD=contrasena-segura-pasajero-demo

# ==============================================================================
# PROVEEDOR DE MAPAS Y CÁLCULO DE RUTAS VIALES
# ==============================================================================
# Proveedor activo: 'osrm' (por defecto, OpenStreetMap carreteras reales),
# 'openrouteservice' (requiere OPENROUTESERVICE_API_KEY), o 'google' (requiere GOOGLE_MAPS_API_KEY).
ROUTING_PROVIDER=osrm

# Servidor OSRM personalizado (opcional; si se omite, usa el servidor oficial de demostración/desarrollo)
OSRM_SERVER_URL=https://router.project-osrm.org

# OpenRouteService API Key (opcional, si ROUTING_PROVIDER=openrouteservice)
OPENROUTESERVICE_API_KEY=

# Google Maps / Routes API Key (SOLO SERVIDOR, opcional si ROUTING_PROVIDER=google)
GOOGLE_MAPS_API_KEY=
